# הגדרות לבדיקות האוטומטיות (npm test).
# העתיקי לקובץ בשם .env.test ועדכני את DATABASE_URL.
# ⚠️ הבדיקות מוחקות את כל הנתונים במסד הזה! לכן שם המסד חייב לכלול "test",
#    אחרת הבדיקות יסרבו לרוץ. לעולם אל תשתמשי כאן במסד של הענן.
NODE_ENV=test
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ezer_test?schema=public
JWT_SECRET=test-secret-that-is-long-enough-for-hs256-signing-0123456789
JWT_EXPIRES_IN=1h
CORS_ORIGINS=http://localhost:5173
CLIENT_URL=http://localhost:5173
CRON_SECRET=test-cron-secret-1234567890
LOGIN_RATE_LIMIT=false
BREVO_API_KEY=
EMAIL_FROM=
