# ============================================================
# הגדרות השרת – העתיקי את הקובץ הזה לקובץ חדש בשם .env ומלאי ערכים.
# את הקובץ .env לא מעלים ל-GitHub (הוא כבר מופיע ב-.gitignore).
# בענן (Render) מכניסים את אותם משתנים במסך Environment.
# ============================================================

# development במחשב, production בענן
NODE_ENV=development

# הפורט של השרת במחשב. ב-Render הפורט נקבע אוטומטית – אין צורך להגדיר
PORT=4000

# ---------- מסד נתונים (חובה) ----------
# במחשב (PostgreSQL מקומי):
#   postgresql://postgres:הסיסמה_שלך@localhost:5432/ezer_dev?schema=public
# בענן (Neon / Supabase) – מעתיקים את ה-Connection String מהאתר שלהם
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ezer_dev?schema=public

# ---------- התחברות (חובה) ----------
# מחרוזת סודית ארוכה (32 תווים לפחות). ליצירה:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_to_a_long_random_secret_at_least_32_chars
# כמה זמן ההתחברות תקפה (7d = שבעה ימים, 12h = 12 שעות)
JWT_EXPIRES_IN=7d

# ---------- האתר של React ----------
# כתובות שמותר להן לפנות לשרת מהדפדפן, מופרדות בפסיק (בלי / בסוף)
# לדוגמה: http://localhost:5173,https://ezer-leyoledet.onrender.com
CORS_ORIGINS=http://localhost:5173
# כתובת אתר ה-React – לקישורים שבתוך המיילים
CLIENT_URL=http://localhost:5173

# ---------- הגדרות הארגון ----------
DEFAULT_COLLECTION_POINT=כתובת נקודת האיסוף של הארגון
TIMEZONE=Asia/Jerusalem

# ---------- מיילים – Brevo (רשות) ----------
# בלי שני הערכים האלה המיילים לא נשלחים, רק נרשמים ביומן השרת (Logs)
BREVO_API_KEY=
# כתובת השולחת – חייבת להיות כתובת שאומתה ב-Brevo
EMAIL_FROM=
EMAIL_FROM_NAME=עזר ליולדת

# ---------- תזכורות מתוזמנות – cron-job.org (רשות) ----------
# קוד סודי (16 תווים לפחות). אותו קוד מכניסים ב-cron-job.org
CRON_SECRET=

# ---------- נתונים התחלתיים בענן (רשות, רק ל-NODE_ENV=production) ----------
# המנהלת נוצרת בהפעלה הראשונה (אם עוד לא קיימת)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=
SEED_ADMIN_PHONE=
# true = ליצור גם נתוני הדגמה (משפחות, מתנדבות, שבתות) – מתאים להצגת הפרויקט
SEED_DEMO_DATA=false
# הסיסמה של המתנדבות לדוגמה (sara@example.com ועוד) כשיש נתוני הדגמה
SEED_DEMO_PASSWORD=

# הגבלת ניסיונות התחברות (מומלץ להשאיר true)
LOGIN_RATE_LIMIT=true
