// סכמת מסד הנתונים של "עזר ליולדת"
// כל שינוי בקובץ הזה דורש migration חדש: npm run db:migrate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VOLUNTEER
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum FamilyStatus {
  ACTIVE
  FINISHED
}

enum Category {
  MAIN
  SALAD
  DESSERT
  OTHER
}

enum ShabbatStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SlotStatus {
  OPEN
  TAKEN
  DELIVERED
}

enum AssignmentStatus {
  ACTIVE
  DELIVERED
  CANCELLED
}

/// נשות הקהילה – מנהלת ומתנדבות
model User {
  id                 Int        @id @default(autoincrement())
  firstName          String     @db.VarChar(50)
  lastName           String     @db.VarChar(50)
  email              String     @unique @db.VarChar(254)
  phone              String     @db.VarChar(20)
  passwordHash       String
  address            String?    @db.VarChar(200)
  role               Role       @default(VOLUNTEER)
  status             UserStatus @default(PENDING)
  receiveWeeklyEmail Boolean    @default(true)
  notes              String?    @db.VarChar(1000)
  resetTokenHash     String?    @unique
  resetTokenExpires  DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  assignments Assignment[]

  @@index([status])
  @@map("users")
}

/// משפחות השמחות שמקבלות ארוחות
model Family {
  id            Int          @id @default(autoincrement())
  familyName    String       @db.VarChar(100)
  contactPhone  String?      @db.VarChar(20)
  address       String?      @db.VarChar(200)
  peopleCount   Int
  simchaType    String       @db.VarChar(50)
  firstShabbat  DateTime     @db.Date
  lastShabbat   DateTime     @db.Date
  dietaryNotes  String?      @db.VarChar(500)
  deliveryNotes String?      @db.VarChar(500)
  status        FamilyStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  slots MealSlot[]

  @@index([status])
  @@map("families")
}

/// רשימת המאכלים שאפשר לבחור
model Product {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  category    Category
  description String?  @db.VarChar(300)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments Assignment[]

  @@unique([name, category])
  @@map("products")
}

/// שבת אחת = מחזור שיבוץ אחד
model Shabbat {
  id                    Int           @id @default(autoincrement())
  shabbatDate           DateTime      @unique @db.Date
  parasha               String        @db.VarChar(50)
  deliveryDeadline      DateTime
  collectionPoint       String        @db.VarChar(200)
  message               String?       @db.VarChar(2000)
  status                ShabbatStatus @default(DRAFT)
  publishedAt           DateTime?
  reminderSentAt        DateTime?
  openSlotsReportSentAt DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  slots MealSlot[]

  @@index([status])
  @@map("shabbatot")
}

/// "דבר אחד שצריך להביא": משפחה + קטגוריה בשבת מסוימת
model MealSlot {
  id        Int        @id @default(autoincrement())
  shabbatId Int
  familyId  Int
  category  Category
  portions  Int
  status    SlotStatus @default(OPEN)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  shabbat     Shabbat      @relation(fields: [shabbatId], references: [id], onDelete: Cascade)
  family      Family       @relation(fields: [familyId], references: [id], onDelete: Restrict)
  assignments Assignment[]

  @@index([shabbatId, status])
  @@index([familyId])
  @@map("meal_slots")
}

/// מי מביאה מה. לכל משבצת לכל היותר שיבוץ אחד שאינו מבוטל
/// (אילוץ ייחודי חלקי שמוגדר ב-migration: assignments_one_live_per_slot)
model Assignment {
  id          Int              @id @default(autoincrement())
  slotId      Int
  userId      Int
  productId   Int
  status      AssignmentStatus @default(ACTIVE)
  note        String?          @db.VarChar(300)
  createdAt   DateTime         @default(now())
  cancelledAt DateTime?
  deliveredAt DateTime?

  slot    MealSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  product Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([slotId])
  @@index([userId, status])
  @@map("assignments")
}
